{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Benefits Benefit Offers Compliance API",
    "version": "2026-05-22"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Compliance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Show Company Compliance Profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/companies/:company_id/compliance_profile",
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the compliance profile for the company including hiring eligibility signals."
        },
        {
          "info": {
            "name": "Show Employment Onboarding Reserves Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/companies/:company_id/employment_onboarding_reserves_status",
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Inspect the reserve payment status used to gate new EOR hires for the company."
        }
      ]
    }
  ],
  "bundled": true
}