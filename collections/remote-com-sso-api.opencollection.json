              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create The SSO Configuration"
        },
        {
          "info": {
            "name": "Show The SSO Configuration Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/sso_configuration/details"
