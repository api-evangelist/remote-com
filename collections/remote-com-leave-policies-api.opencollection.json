{
  "opencollection": "1.0.0",
  "info": {
    "name": "Remote Benefits Benefit Offers Leave Policies API",
    "version": "2026-05-22"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Leave Policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Leave Policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/leave_policies",
            "params": [
              {
                "name": "country_code",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List Leave Policies"
        },
        {
          "info": {
            "name": "Show A Leave Policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.remote.com/v1/leave_policies/:leave_policy_id",
            "params": [
              {
                "name": "leave_policy_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Show A Leave Policy"
        }
      ]
    }
  ],
  "bundled": true
}